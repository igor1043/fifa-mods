		,{
			"name":"showResetTeamsPopup"
			,"onEnter":
			[
				["loadView", ["popup","ResetTeams", "ResetAllSquadsMessage|Yes|advance|No|back"]]
				,["loadView",["background", "BOOTFLOW"]]

			]
			,"onExit":
			[
				["unloadView", ["popup", "ResetTeams"]]
				,["unloadView",["background"]]
			]
			,"transitions":
			[
				{
					"event":"back"
					,"targets":["mainMenu"]
				}	
				,{
					"event":"advance"
					,"actions":[ ["sendScreenEvent", ["ResetSquadsPopupCallBack",""]] ]					
					,"targets":["mainMenu"]
