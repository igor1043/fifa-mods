				{"event":"popupYes","actions":[ ["sendScreenEvent",["UXDemoNotifyReturnToStart"]] ],"targets":["profileDemoSignOut"]}
				,{"event":"popupNo","targets":["mainMenu"]}						
			]		
		}
		,{
			"name":"upsellFlow"
			,"type":"external"
			,"file":"/upsellFlow.nav"
			,"outputs":
			{
				"out_back":"mainMenu"
				,"out_MainMenu":"mainMenu"
			}
		}
	]
}
