		,{
			"name":"PracticeArenaFlow"
			, "initial":
			{
				"targets":["ArenaGameplayPrepare"]
			}
			,"onEnter":
			[
				["if", [["==", ".skipBootflow", "true"]
				,[
					["sendScreenEvent", ["UxSetFlowState",".eState.ARENA"]]
					,["sendScreenEvent", ["UxSetFlowSubState",".eSubState.SUBSTATE_NONE"]]
				]
				,[
					["loadViewModel", ["PracticeArenaViewModel"]]
					,["sendAction", ["enterPracticeArena"]]
					,["sendAction",["updateLocGender", "checkGender"]]
				]]]
			]
			,"onExit":
			[
				["if", [["==", ".skipBootflow", "true"]
				,[ /* Don't do anything */
				]
				,[ 
					["sendAction",["updateLocGender", "resetGender"]]
				    ,["unloadViewModel", ["PracticeArenaViewModel"]]
				]]]
			]
			,"states":
			[
				{
					"name":"PracticeArenaProfileSignOutWait"
					,"transitions":
					[
						{
							"event":"profileSignOutComplete"
							,"targets":["profileSignOut"]
						}
					]
				}
				,{
					"transitions":
					[
						{ "event":"profileSignOut", "targets":["PracticeArenaProfileSignOutWait"] }
					]
					,"states":
					[
						{
							"name":"ArenaGameplayPrepare"
							,"onEnter":
							[
								["if", [["==", ".skipBootflow", "true"]
								,[
									["invoke", ["freeRoamReady"]]
								]
								,[ /* Don't do anything */
								]]]
							]
							,"transitions":
							[
								{"event":"freeRoamReady","targets":["ArenaGameplay"]}
							]
						}
						,{
							"name":"ArenaGameplay"
							,"onEnter":
							[
								["sendAction", ["transitionManager", ".NavTransitionManager.TO_GAME"]]
							]
							,"onExit":
							[
								["sendAction", ["transitionManager", ".NavTransitionManager.TO_FE"]]
							]
							,"transitions":
							[
								{"event":"advance","targets":["ArenaSideSelect"]}
								,{"event":"back","targets":["mainMenu"]}
								,{"event":"InstantReplay","targets":["instantReplay"]}
								,{"event":"evt_sign_out","targets":["ArenaSideSelect"]}
							]
						}
						,{
							"name":"instantReplay"
							,"onEnter":
							[
								["sendAction", ["transitionManager", ".NavTransitionManager.TO_FE"]]
								,["loadView", ["screen", "game/screens/instantReplay/ReplayScreen", "", ".direction"]]
							]
							,"onExit":
							[
								["unloadView",["screen", "game/screens/instantReplay/ReplayScreen", "", ".direction"]]
							]
							,"transitions":
							[
								{"event":"back","targets":["ArenaGameplay"]}
							]		
						}	
						,{
							"name":"ArenaSideSelect"
							,"onEnter":
							[
								["loadViewModel",["SideSelectViewModel", ".direction"]],
								["loadView",["screen", "game/screens/playNow/SideSelect", "", ".direction"]]
							]
							,"onExit":
							[
								["sendScreenEvent", ["PracticeModeNotifyEvent","5"]],
								["unloadViewModel",["SideSelectViewModel"]],
								["unloadView",["screen", "game/screens/playNow/SideSelect"]]
							]
							,"transitions":
							[
								{
									"event":"advance"
									,"targets":["ArenaGameplay"]
								}
								,{
									"event":"back"
									,"targets":["ArenaGameplay"]
								}
								,{
									"event":"btnY"
									,"targets":["ArenaControllerSetup"]
								}	
							]
						}
						,{
							"name":"ArenaControllerSetup"
							,"onEnter":
							[
								["loadView",["screen", "game/screens/settings/controllerAndGameSetup"]]
							]
							,"onExit":
							[
								["unloadView",["screen", "game/screens/settings/controllerAndGameSetup"]]
							]
							,"transitions":
							[
								{
									"event":"back"
									,"targets":["ArenaSideSelect"]
									,"let":{ "direction":"back" }
								}
							]
						}
					]
				}
			]
		}
