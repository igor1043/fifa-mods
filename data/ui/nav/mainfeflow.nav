		}
		,{
			"name": "sharedSquadCopiedPopup",
			"onEnter":
			[
				["loadView", ["popup", "POW_SHARED_SQUAD_COPIED", "TXT_EASFC_SHARED_SQUAD_COPIED|OK|back"]]
			],
