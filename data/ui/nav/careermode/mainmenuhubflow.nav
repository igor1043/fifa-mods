			,{
				"name":"PreSeasonTourInvite"
				,"onEnter":
				[
					["loadScreenController", ["PreSeasonTourInvite"]]
					,["loadView", ["screen", "game/screens/career/preSeasonTour/PreSeasonTourInvite"]]
					,["loadView",["background", "BOOTFLOW"]]
				]
				,"onExit":
				[
					["unloadView", ["screen", "game/screens/career/preSeasonTour/PreSeasonTourInvite"]]
					,["unloadScreenController", ["PreSeasonTourInvite"]]
					,["unloadView",["background"]]
				]
				,"transitions":
				[
					{
						"event":"EnterPreSeasonTourSelection"
						,"targets":["PreSeasonTourSelection"]
					}
					,{
						"event":"Advance"
						,"targets":["Autosave"]
					}
				]
			}
			,{
				"name":"PreSeasonTourSelection"
				,"onEnter":
				[
					["loadScreenController", ["PreSeasonTourSelection"]]
					,["loadView", ["screen", "game/screens/career/preSeasonTour/PreSeasonTourSelection"]]
					,["loadView",["background", "BOOTFLOW"]]
				]
				,"onExit":
				[
					["unloadView", ["screen", "game/screens/career/preSeasonTour/PreSeasonTourSelection"]]
					,["unloadScreenController", ["PreSeasonTourSelection"]]
					,["unloadView",["background"]]
				]
				,"transitions":
				[
					{
						"event":"Advance"
						,"targets":["Autosave"]
					}
				]
			}
			,{
				"name":"GTNScoutReportFromReportTile"
				,"type":"external"
				,"file":"/careerMode/gtnScoutReportFlow.nav"
				,"outputs":
				{
					"Back":"MainMenuHub"
				}
			}
			,{
				"name":"Inbox"
				,"type":"external"
				,"file":"/careerMode/inboxFlow.nav"
				,"outputs":
				{
					"Back":"MainMenuHub"
				}
			}
			,{
				"onEnter":
				[
					["loadScreenController", ["Save"]]
				]
				,"onExit":
				[
					["unloadScreenController", ["Save"]]
				]
				,"states":
				[
					{
						"type":"external"
						,"file":"/saveload/save.nav"
						,"inputs":
						{
							"SaveInQuitFlow":"in_SaveDefault"
						}
						,"outputs":
						{
							"out_Back":"PostSave"		/* Unexpected case */
							,"out_Success":"PostSave"
							,"out_Failure":"PostSave"
						}
					}
					,{
						"type":"external"
						,"file":"/saveload/save.nav"
						,"inputs":
						{
							"SaveInMainMenuHub":"in_SaveDefault"
						}
						,"outputs":
						{
							"out_Back":"MainMenuHub"		/* Unexpected case */
							,"out_Success":"MainMenuHub"
							,"out_Failure":"MainMenuHub"
						}
					}
					,{
						"name":"PostSave"
						,"onEnter":
						[
							["invoke", ["QuitMode"]]
						]
					}
				]
			}
			,{
				"name":"Calendar"
				,"type":"external"
				,"file":"/careerMode/CalendarFlow.nav"
				,"outputs":
				{
					"Back":"MainMenuHub"
					,"PreSeasonTourInvite":"PreSeasonTourInvite"
				}
			}
			,{
				"name":"JobOffers"
				,"type":"external"
				,"file":"/careerMode/jobOffersFlow.nav"
				,"outputs":
				{
					"Back":"MainMenuHub"
				}
			}
			,{
				"name":"InternationalOffers"
				,"type":"external"
				,"file":"/careerMode/internationalOffersFlow.nav"
				,"outputs":
				{
					"out_Back":"MainMenuHub"
					,"out_Inbox":"Inbox"
				}
			}
			,{
				"name":"JobOfferSign"
				,"type":"external"
				,"file":"/careerMode/jobOfferSignFlow.nav"
				,"outputs":
				{
					"Back":"MainMenuHub"
				}
			}
			,{
				"name":"InitNewSeason"
				,"type":"external"
				,"file":"/careerMode/initNewSeasonFlow.nav"
			}
