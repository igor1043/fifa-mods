						,"actions":[ ["executeCMAction",["ToggleUserSim"]] ]
					}
					,{
						"event":"EnterAdditionalFunds"
						,"targets":["AdditionalFunds"]
					}
					,{
						"event":"ShowResignInternationalJobPopUp"
						,"actions":[ ["executeCMAction",["ShowResignInternationalJobPopUp"]] ]
					}
					,{
						"event":"ResignInternationalJob"
						,"actions":[ ["executeCMAction",["ResignInternationalJob"]] ]
					}
					,{
						"event":"EnterCareerSummary"
						,"targets":["CareerSummary"]
					}
					,{
						"event":"EnterSquadCallup"
						,"targets":["SquadCallup"]
					}
					,{
						"event":"EnterSquadCallupFromPopup"
