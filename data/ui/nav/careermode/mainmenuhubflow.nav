			,{
				"name":"VirtualPro"
				,"onEnter":
				[
					["loadScreenController", ["VirtualPro"]]
					, ["loadView",["screen", "game/screens/virtualPro/VPro_Accomplishments"]]
				]
				,"onExit":
				[
					["unloadView",["screen", "game/screens/virtualPro/VPro_Accomplishments"]]
					,["unloadScreenController", ["VirtualPro"]]
				]
				,"transitions":
				[
					{
						"event":"Back"
						,"targets":["MainMenuHub"]
					}
				]
			}
			,{
				"onEnter":
				[
					["loadViewModel",["VirtualProViewModel"]]
				]
				,"onExit":
				[
					["unloadViewModel",["VirtualProViewModel"]]
				]
				,"states":
				[
					{
						"name":"VirtualProProfileSignOutWait"
					}
					,{
						"name":"EditVirtualProPlayerFlow"
						,"onEnter":
						[
							["loadScreenController", ["VirtualProPlayer"]]
							,["loadView", ["screen", "game/screens/virtualPro/VPro_HUB"]]
						]
						,"onExit":
						[
							["unloadView", ["screen", "game/screens/virtualPro/VPro_HUB"]]
							,["unloadScreenController", ["VirtualProPlayer"]]
						]
						,"transitions":
						[
							{ "event":"profileSignOut", "targets":["VirtualProProfileSignOutWait"] }
						]
						,"states":
						[
							{
								"name":"EditVProMain"
								,"transitions":
								[
									{
										"event":"SaveVirtualProEdit"
										,"targets":["MainMenuHub"]
										,"actions":[ ["executeCMAction",["LeaveVProEdit"]] ]
									}
									,{
										"event":"Back"
										,"targets":["MainMenuHub"]
										,"actions":[ ["executeCMAction",["LeaveVProEdit"]] ]
									}
									,{ /* this event is fired when not logged in */
										"event":"gamefaceLoginFlow"
										,"targets":["gameFaceLogin"]
									}
									,{ /* this event is fired when logged in */
										"event":"requestDownload"
										,"targets":["CheckGameFace"]
									}
								]
							}
							,{
								"type":"external"
								,"file":"/online/onlineLoginFlow.nav"
								,"inputs":
								{
									"gameFaceLogin":"startLoginWithoutMultiplayerCheck"
								}
								,"outputs":
								{
									"loginSuccess":"CheckGameFace"
									,"loginFail":"EditVProMain"
								}
							}
							,{
								"name":"CheckGameFace"
								,"onEnter":
								[
									["sendAction",["condition", "isGameFaceAvailable"]]
								]
								,"transitions":
								[
									{
										"event":"true"
										,"targets":["GameFaceDownload"]
									}
									,{
										"event":"false"
										,"targets":["NoGameFacePopup"]
									}
								]
							}
							,{
								"name":"NoGameFacePopup"
								,"onEnter":
								[
									["loadView", ["popup", "TXT_GAMEFACE_NOT_AVAILABLE", "TXT_GAMEFACE_NOT_AVAILABLE|Okay|back"]]
								]
								,"onExit":
								[
									["unloadView", ["popup", "TXT_GAMEFACE_NOT_AVAILABLE"]]
								]
								,"transitions":
								[
									{
										"event":"back"
										,"targets":["EditVProMain"]
									}
								]
							}
						]
					}
				]
			}
			,{
				"name":"GameFaceDownload"
				,"onEnter":
				[

					["sendScreenEvent", ["SetLiveDbDownloadState", "0"]]
					,["loadView",["screen", "game/screens/liveDB/livedb_downloadLiveDB"]]
				]
				,"onExit":
				[
					["unloadView",["screen", "game/screens/liveDB/livedb_downloadLiveDB"]]
				]
				,"transitions":
				[
					{
						"event":"back"
						,"targets":["EditVirtualProPlayerFlow"]
					}
				]
			}
