{
	"name":"MainMenuHubFlow"
	,"initial": { "targets":["PreSeasonTourFlow"] }
	,"onEnter":
	[
		["sendAction", ["notify", "telemetryEnterGameModeHub", ".GameMode"] ]
	]

	,"states":
	[
		{
		"transitions":
		[
			{
				"event":"GotoPreSeasonTourFlow"
				,"targets":["PreSeasonTourFlow"]
			}
			,{
				"event":"GotoMainMenuHub"
				,"targets":["MainMenuHub"]
			}
		]
		,"states":
		[

			{
				"onEnter":
				[
					["unloadView",["screen"]]
				]
				,"states":
				[
					{
						"name":"PreSeasonTourFlow"
						,"onEnter":
						[
							["executeCMAction",["EnterPreSeasonTourFlow"]]
						]
						,"transitions":
						[
							{
								"event":"EnterPreSeasonTourInvite"
								,"targets":["PreSeasonTourInvite"]
							}
							,{
								"event":"AutoSavePreSeasonTour"
								,"targets":["Autosave"]
							}
							,{
								"event":"Advance"
								,"targets":["MainMenuHub"]
							}
						]
					}
					,{
						"name":"MainMenuHub"
						,"initial": { "targets":["CareerHub"] }
						,"onEnter":
						[
							["sendScreenEvent", ["UxSetFlowSubState",".eSubState.CENTRAL"]]
							,["loadScreenController", ["MainMenuHub"]]
							,["loadViewModel",["FluxViewModel"]]
							,["loadViewModel",["StartingXIViewModel"]]
							,["loadViewModel",["CareerHubViewModel"]]
							,["loadView",["screen", "game/screens/fluxHub/FluxHub"]]
							,["sendAction",["updateLocGender", "checkGender"]]
							,["sendAction", ["setStadiumPosition", ""] ] /* CareerHubViewModel knows what camera to set depending on PAP/PAM Career */
							,["loadView",["background", "BOOTFLOW"]]
						]
						,"onExit":
						[
							["unloadView",["screen", "game/screens/fluxHub/FluxHub"]]
							,["unloadViewModel",["CareerHubViewModel"]]
							,["unloadViewModel",["StartingXIViewModel"]]
							,["unloadViewModel",["FluxViewModel"]]
							,["unloadScreenController",["MainMenuHub"]]
							,["unloadView",["background"]]

						]
						,"states":
						[
							{
								"name":"ActionPopup"
								,"type":"external"
								,"file":"/careerMode/actionPopupFlow.nav"
								,"outputs":
								{
									"BackFromPopup":"CareerHub"
									,"BackFromScreen":"MainMenuHubWithPopup"
								}
							}
							,{
								"name":"MainMenuHubWithPopup"
								,"onEnter":
								[
									["loadView",["screen", "game/screens/fluxHub/FluxHub"]]
								]
								,"transitions":
								[
									{
										"event":"Ready"
										,"targets":["ActionPopup"]
									}
								]
							}
							,{
								"name":"CareerHub"
								,"onEnter":
								[
									["sendAction",["updateScreen", "RefreshCareerHub"]]
									,["executeCMAction",["CacheTeamSheet"]]
								]
								,"transitions":
								[
									{	"event":"EnterTeamManagement","let":{"tmMode":"offlineCareer"},"targets":["TeamManagementFlow"]}
									,{	"event":"EnterTeamSheetSelect","targets":["TeamSheetSelect"]}
									,{	"event":"EnterTeamManagementFromHubManualFix","let":{"tmMode":"offlineCareer"},"targets":["TeamManagementFlow"],"actions":[ ["executeCMAction",["EnterTeamManagementFromHubManualFix"]] ]}
									,{	"event":"EnterPlayerAction","targets":["ActionPopup"]}
									,{	"event":"Advance", "targets":["CareerHubNoScreenSaver"], "actions":[ ["executeCMAction",["StartHubSim"]] ]}
									,{ "event":"EnterPreSeasonTourInvite", "targets":["PreSeasonTourInvite"] }
								]
								,"states":
								[
									{
										"name":"CareerHubIdle"
										,"onEnter":
										[
											["loadViewModel", ["ScreenTimeoutViewModel", "FADE_MAIN_MENU"]]
										]
										,"onExit":
										[
											["unloadViewModel", ["ScreenTimeoutViewModel"]]
										]
										,"transitions":
										[
											{"event":"evt_countdown_done", "targets":["MainMenuHubStadiumPan"]}
											,{"event":"evt_popup_enter", "targets":["CareerHubNoScreenSaver"]}
											,{"event":"evt_pow_open_widget", "targets":["CareerHubEASFCWidgetOpened"]}
										]
									}
									,{
										"name":"CareerHubEASFCWidgetOpened"
										,"transitions":
										[
											{"event":"evt_pow_close_widget", "targets":["CareerHubIdle"]}
										]
									}
									,{
										"states":
										[
											{
												"name":"CareerHubNoScreenSaver"
												,"transitions":
												[
													{
														"event":"evt_popup_enter"
														,"targets":["CareerHubNoScreenSaverWithPopup"]
													}
													,{
														"event":"evt_popup_exit"
														,"targets":["CareerHubIdle"]
													}
													,{
														"event":"CalendarInterruptSim"
														,"targets":["CareerHubIdle"]
														,"actions":[ ["executeCMAction",["UserInterruptSim"]] ]
													}
													,{
														"event":"Back"
														,"targets":["CareerHubIdle"]
														,"actions":[ ["executeCMAction",["UserInterruptSim"]] ]
													}
												]

											}
											,{
												"name":"CareerHubNoScreenSaverWithPopup"
												,"transitions":
												[
													{
														"event":"evt_popup_exit"
														,"targets":["CareerHubNoScreenSaver"]
													}
													,{
														"event":"CalendarInterruptSim"
														,"targets":["CareerHubNoScreenSaverWaitPopup"]
														,"actions":[ ["executeCMAction",["UserInterruptSim"]] ]
													}
													,{
														"event":"Back"
														,"targets":["CareerHubNoScreenSaverWaitPopup"]
														,"actions":[ ["executeCMAction",["UserInterruptSim"]] ]
													}
												]
											}
											,{
												"name":"CareerHubNoScreenSaverWaitPopup"
												,"transitions":
												[
													{
														"event":"evt_popup_exit"
														,"targets":["CareerHubIdle"]
													}
												]

											}
										]
									}
								]
							}
						]
					}
					,{
						"name":"MainMenuHubStadiumPan"
						,"type":"external"
						,"file":"/stadiumPanFlow.nav"
						,"outputs":
						{
							"out_back":"MainMenuHub"
						}
					}
					,{
						"name":"TeamManagementFlow"
						,"type":"external"
						,"file":"/editTeamSheetFlow.nav"
						,"outputs":
						{
							"back":"CareerHub"
						}
					}
					,{
						"name":"RetirementRemoveFlow"
						,"type":"external"
						,"file":"/retirementremoveflow.nav"
						,"outputs":
						{
							"back":"MainMenuHub"
						}
					}
					,{
						"name":"RetirementResetAgeFlow"
						,"type":"external"
						,"file":"/retirementresetageflow.nav"
						,"outputs":
						{
							"back":"MainMenuHub"
						}
					}
					,{
						"name":"RetirementAddFunds100KFlow"
						,"type":"external"
						,"file":"/retirementaddfunds100kflow.nav"
						,"outputs":
						{
							"back":"MainMenuHub"
						}
					}
					,{
						"name":"RetirementAddFunds300KFlow"
						,"type":"external"
						,"file":"/retirementaddfunds300kflow.nav"
						,"outputs":
						{
							"back":"MainMenuHub"
						}
					}
					,{
						"let":{"tmMode":"offlineCareer"}
						,"states":
						[
							{
								"name":"TeamSheetSelectExternal"
								,"type":"external"
								,"file":"/editTeamManagementFlow.nav"
								,"inputs":
								{
									"TeamSheetSelect":"teamSheetSelection"
								}
								,"outputs":
								{
									"back":"CareerHub"
								}
							}
						]
					}
					,{
						"name":"Autosave"
						,"onEnter":
						[
							["loadViewModel",["CareerAutosaveViewModel"]]
							,["executeCMAction",["DoAutoSave"]]
						]
						,"onExit":
						[
							["unloadViewModel",["CareerAutosaveViewModel"]]
						]
						,"transitions":
						[
							{
								"event":"Advance"
								,"targets":["MainMenuHub"]
							}
						]
					}
				]
				,"transitions":
				[
					{
						"event":"back"
						,"actions":[ ["executeCMAction",["MainMenuBack"]] ]
					}
					,{
						"event":"DeadlineDayAdvance"
						,"actions":[ ["executeCMAction",["AdvanceDeadlineDay"]] ]
					}
					,{
						"event":"EnterSackedEmail"
						,"targets":["Inbox"]
						,"actions":[ ["executeCMAction",["GenerateSackedMail"]] ]
					}
					,{
						"event":"Forfeit"
						,"actions":[ ["executeCMAction",["HubForfeit"]] ]
					}
					,{
						"event":"OpponentForfeit"
						,"actions":[ ["executeCMAction",["HubOpponentForfeit"]] ]
					}
					,{
						"event":"SaveAndQuitMode"
						,"targets":["SaveInQuitFlow"]
						,"actions":[ ["executeCMAction",["EnterSaveFromQuitFlow"]] ]
					}
					,{
						"event":"ShowMyActions"
						,"actions":[ ["executeCMAction",["ShowMyActions"]] ]
					}
					,{
						"event":"EnterCalendar"
						,"targets":["Calendar"]
						,"actions":[ ["executeCMAction",["EnterCalendar"]] ]
					}
					,{
						"event":"EnterInternationalOffers"
						,"targets":["InternationalOffers"]
					}
					,{
						"event":"EnterMessages"
						,"targets":["Inbox"]
						,"actions":[ ["executeCMAction",["UserInterruptSim"]], ["executeCMAction",["EnterMessages"]] ]
					}
					,{
						"event":"EnterTalkToPress"
						,"targets":["TalkToPress"]
					}
					,{
						"event":"MainMenuBack"
						,"actions":[ ["executeCMAction",["MainMenuBack"]] ]
					}
					,{
						"event":"EnterJobOfferSign"
						,"targets":["JobOfferSign"]
						,"actions":[ ["executeCMAction",["JobOfferSignFromHub"]] ]
					}
					,{
						"event":"EnterEndOfSeason"
						,"targets":["Inbox"]
						,"actions":[ ["executeCMAction",["EndSeasonHubAdvance"]] ]
					}					,{
						"event":"RetirementRemove"
						,"targets":["RetirementRemoveFlow"]
					}
					,{
						"event":"RetirementResetAge"
						,"targets":["RetirementResetAgeFlow"]
					}
					,{
						"event":"RetirementAddFunds100K"
						,"targets":["RetirementAddFunds100KFlow"]
					}
					,{
						"event":"RetirementAddFunds300K"
						,"targets":["RetirementAddFunds300KFlow"]
					}
					,{
						"event":"MoveToNewClub"
						,"targets":["InitNewSeason"]
						,"actions":[ ["executeCMAction",["MoveToNewClub"]] ]
					}
					,{
						"event":"SwitchJob"
						,"targets":["Inbox"]
						,"actions":[ ["executeCMAction",["StartSwitchJob"]] ]
					}
					,{
						"event":"EnterBrowseJobs"
						,"targets":["JobOffers"]
						,"actions":[ ["executeCMAction",["BrowseJobs"]] ]
					}
					,{
						"event":"EnterBrowseJobsAlreadyApplied"
						,"actions":[ ["executeCMAction",["EnterBrowseJobsPopup"]] ]
					}
					,{
						"event":"Retire"
						,"targets":["JobOffers"]
						,"actions":[ ["executeCMAction",["Retire"]] ]
					}
					,{
						"event":"EnterPlayerContracts"
						,"targets":["PlayerContracts"]
						,"actions":[ ["executeCMAction",["EnterPlayerContracts"]] ]
					}















					,{
						"event":"EnterSquadReport"
						,"targets":["SquadReport"]
						,"actions":[ ["executeCMAction",["EnterSquadReport"]] ]
					}
					,{
						"event":"EnterEditKitNumber"
						,"targets":["EditKitNumber"]
					}
					,{
						"event":"EnterInjuryList"
						,"targets":["InjuryList"]
					}
					,{
						"event":"EnterContractOffer"
						,"targets":["ContractOffer"]
					}
					,{
						"event":"EnterSellPlayers"
						,"targets":["SellPlayers"]
					}
					,{
						"event":"EnterViewShortlist"
						,"targets":["ViewShortlist"]
					}
					,{
						"event":"EnterViewShortlistPopup"
						,"actions":[ ["executeCMAction",["EnterPopup"]] ]
					}
					,{
						"event":"EnterNegHistory"
						,"targets":["NegHistory"]
						,"actions":[ ["executeCMAction",["EnterNegHistoryFromHub"]] ]
					}
					,{
						"event":"EnterBudgetAlloc"
						,"targets":["BudgetAlloc"]
						,"actions":[ ["executeCMAction",["EnterBudgetAlloc"]] ]
					}
					,{
						"event":"EnterStandings"
						,"targets":["ViewOtherComps"]
						,"actions":[ ["executeCMAction",["ViewComps"]] ]
					},
																											{"event":"EnterLeagueDashboard","targets":["LeagueDashboardFlow"],"actions":[["executeCMAction",["ViewComps"]]]}
					,{
						"event":"SelectStat"
						,"targets":["Statistics"]
					}
					,{
						"event":"EnterTeamStats"
						,"targets":["TeamStatistics"]
						,"actions":[ ["executeCMAction",["ViewTeamStatistics"]] ]
					}
					,{
						"event":"EnterFixtures"
						,"targets":["Fixtures"]
					}
					,{
						"event":"EnterTournamentTree"
						,"targets":["ViewTournamentTree"]
						,"actions":[ ["executeCMAction",["ViewTournamentTreeFromHub"]] ]
					}
					,{
						"event":"ViewOtherCompetitions"
						,"targets":["ViewOtherComps"]
						,"actions":[ ["executeCMAction",["ViewOtherComps"]] ]
					}
					,{
						"event":"SelectCompetition"
						,"actions":[ ["executeCMAction",["ViewCompStats"]] ]
					}
					,{
						"event":"EnterYouthScout"
						,"actions":[ ["executeCMAction",["EnterYouthScout"]] ]
					}
					,{
						"event":"EnterScoutNetwork"
						,"targets":["ScoutNetwork"]
					}
					,{
						"event":"EnterYouthSquad"
						,"targets":["YouthSquad"]
						,"actions":[ ["executeCMAction",["EnterYouthSquad"]] ]
					}
					,{
						"event":"ViewYouthSquadPopup"
						,"actions":[ ["executeCMAction",["YouthSquadShowPopup"]] ]
					}
					,{
						"event":"EnterEditPlayer"
						,"targets":["SelectEditPlayer"]
						,"actions":[ ["executeCMAction",["EnterEditPlayer"]] ]
					}
					,{
						"event":"EnterSave"
						,"targets":["SaveInMainMenuHub"]
						,"actions":[ ["executeCMAction",["EnterSaveFromMainHub"]] ]
					}
					,{
						"event":"EnterGameSettings"
						,"targets":["GameSettings"]
					}
					,{
						"event":"EnterEATrax"
						,"targets":["EATrax"]
					}
					,{
						"event":"EnterMatchSubMenu"
						,"actions":[ ["executeCMAction",["EnterMatchSubMenu"]] ]
					}
					,{
						"event":"AutoAdvanceFromPlay"
						,"actions":
						[
							["executeCMAction",["AutoAdvanceFromPlay"]]
						]
					}
					,{
						"event":"AutoAdvanceFromSim"
						,"actions":
						[
							["executeCMAction",["AutoAdvanceFromSim"]]
						]
					}
					,{
						"event":"EnterMatchSubMenuFromPlay"
						,"actions":
						[
							["sendScreenEvent",["ResetCMControllers"]]
							,["executeCMAction",["EnterMatchSubMenuFromPlay"]]
						]
					}
					,{
						"event":"EnterMatchSubMenuFromSim"
						,"actions":[ ["executeCMAction",["EnterMatchSubMenuFromSim"]] ]
					}
					,{
						"event":"SimMatch"
						,"targets":["SimMatchFlow"]
						,"actions":[ ["executeCMAction",["EnterPreMatchReportForSim"]] ]
					}
					,{
						"event":"PlayMatch"
