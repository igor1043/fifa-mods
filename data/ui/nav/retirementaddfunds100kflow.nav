{
    "name":"RetirementAddFunds100KFlow",
    "initial":{"targets":["RetirementApply"]},
    "states":[
        {
            "name":"RetirementApply",
            "onEnter":[
                ["loadViewModel",["CareerAutosaveViewModel"]],
                ["executeCMAction",["DoAutoSave"]]
            ],
            "onExit":[
                ["unloadViewModel",["CareerAutosaveViewModel"]]
            ],
            "transitions":[
                {"event":"Advance","targets":["back"]}
            ]
        }
    ]
}
