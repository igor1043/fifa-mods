    "ABRIR ELENCO": {"stringid": "FIFA_MODS_CM_OPEN_SQUAD", "translations": {"ara_sa": "فتح التشكيلة", "chi_hk": "開啟陣容", "cze_cz": "Otevřít sestavu", "dan_dk": "Åbn trup", "dut_nl": "Selectie openen", "eng_us": "Open Squad", "fre_fr": "Ouvrir l’effectif", "ger_de": "Kader öffnen", "ita_it": "Apri rosa", "nor_no": "Åpne tropp", "pol_pl": "Otwórz skład", "por_br": "Abrir elenco", "por_pt": "Abrir plantel", "rus_ru": "Открыть состав", "spa_es": "Abrir plantilla", "spa_mx": "Abrir plantilla", "swe_se": "Öppna trupp", "tur_tr": "Kadroyu Aç"}},
    "APROVEITAMENTO GERAL": {"stringid": "FIFA_MODS_CM_OVERALL_PERFORMANCE", "translations": {"ara_sa": "الأداء العام", "chi_hk": "整體表現", "cze_cz": "Celkový výkon", "dan_dk": "Samlet præstation", "dut_nl": "Algemene prestatie", "eng_us": "Overall Performance", "fre_fr": "Performance générale", "ger_de": "Gesamtleistung", "ita_it": "Prestazione complessiva", "nor_no": "Samlet prestasjon", "pol_pl": "Ogólna forma", "por_br": "Aproveitamento geral", "por_pt": "Desempenho geral", "rus_ru": "Общая результативность", "spa_es": "Rendimiento general", "spa_mx": "Rendimiento general", "swe_se": "Övergripande prestation", "tur_tr": "Genel Performans"}},
    "APOSENTADORIA": {"stringid": "FIFA_MODS_RETIREMENT", "translations": {"ara_sa": "اعتزال", "chi_hk": "退役", "cze_cz": "DŮCHOD", "dan_dk": "PENSION", "dut_nl": "PENSIOEN", "eng_us": "RETIREMENT", "fre_fr": "RETRAITE", "ger_de": "RÜCKTRITT", "ita_it": "RITIRO", "nor_no": "PENSJON", "pol_pl": "EMERYTURA", "por_br": "APOSENTADORIA", "por_pt": "APOSENTADORIA", "rus_ru": "ПЕНСИЯ", "spa_es": "RETIRO", "spa_mx": "RETIRO", "swe_se": "PENSION", "tur_tr": "EMEKLİLİK"}},
    "APOSENTADORIA + IDADE": {"stringid": "FIFA_MODS_RETIREMENT_AGE", "translations": {"ara_sa": "اعتزال + العمر", "chi_hk": "退役 + 年齡", "cze_cz": "DŮCHOD + VĚK", "dan_dk": "PENSION + ALDER", "dut_nl": "PENSIOEN + LEEFTIJD", "eng_us": "RET. + AGE", "fre_fr": "RETRAITE + ÂGE", "ger_de": "RÜCKTRITT + ALTER", "ita_it": "RITIRO + ETÀ", "nor_no": "PENSJON + ALDER", "pol_pl": "EMERYTURA + WIEK", "por_br": "APOS. + IDADE", "por_pt": "APOS. + IDADE", "rus_ru": "ПЕНСИЯ + ВОЗРАСТ", "spa_es": "RETIRO + EDAD", "spa_mx": "RETIRO + EDAD", "swe_se": "PENSION + ÅLDER", "tur_tr": "EMEKLİLİK + YAŞ"}},
    "DESCRICAO APOSENTADORIA": {"stringid": "FIFA_MODS_RETIREMENT_DESC", "translations": {"ara_sa": "يزيل اعتزال اللاعبين المحددين.\nاخرج دون حفظ ثم حمّل الحفظ من جديد.", "chi_hk": "移除已標記球員的退役狀態。\n不儲存退出，再重新載入存檔。", "cze_cz": "Zruší odchod označených hráčů do důchodu.\nUkončete bez uložení a znovu načtěte save.", "dan_dk": "Fjerner pensionering for markerede spillere.\nAfslut uden at gemme, og indlæs savet igen.", "dut_nl": "Verwijdert pensioen bij gemarkeerde spelers.\nSluit af zonder op te slaan en laad de save opnieuw.", "eng_us": "Removes retirement from marked players.\nExit without saving, then load the save again.", "fre_fr": "Supprime la retraite des joueurs marqués.\nQuittez sans sauvegarder, puis rechargez la sauvegarde.", "ger_de": "Entfernt den Ruhestand markierter Spieler.\nOhne zu speichern beenden und den Spielstand neu laden.", "ita_it": "Rimuove il ritiro dai giocatori selezionati.\nEsci senza salvare e ricarica il salvataggio.", "nor_no": "Fjerner pensjonering for merkede spillere.\nAvslutt uten å lagre, og last inn lagringen på nytt.", "pol_pl": "Usuwa emeryturę oznaczonych zawodników.\nWyjdź bez zapisywania i wczytaj zapis ponownie.", "por_br": "Remove a aposentadoria dos jogadores marcados.\nSaia sem salvar e carregue o save novamente.", "por_pt": "Remove a reforma dos jogadores marcados.\nSaia sem guardar e carregue o save novamente.", "rus_ru": "Отменяет выход на пенсию отмеченных игроков.\nВыйдите без сохранения и загрузите сейв снова.", "spa_es": "Quita la jubilación de los jugadores marcados.\nSal sin guardar y carga el guardado de nuevo.", "spa_mx": "Quita el retiro de los jugadores marcados.\nSal sin guardar y carga el guardado de nuevo.", "swe_se": "Tar bort pensionering för markerade spelare.\nAvsluta utan att spara och läs in sparningen igen.", "tur_tr": "İşaretli oyuncuların emekliliğini kaldırır.\nKaydetmeden çıkın ve kaydı yeniden yükleyin."}},
    "DESCRICAO APOSENTADORIA + IDADE": {"stringid": "FIFA_MODS_RETIREMENT_AGE_DESC", "translations": {"ara_sa": "يزيل الاعتزال ويعيد ضبط العمر المستهدف.\nاخرج دون حفظ ثم حمّل الحفظ من جديد.", "chi_hk": "移除退役並重設目標年齡。\n不儲存退出，再重新載入存檔。", "cze_cz": "Zruší důchod a obnoví cílový věk.\nUkončete bez uložení a znovu načtěte save.", "dan_dk": "Fjerner pensionering og nulstiller mål-alderen.\nAfslut uden at gemme, og indlæs savet igen.", "dut_nl": "Verwijdert pensioen en herstelt de doelleeftijd.\nSluit af zonder op te slaan en laad de save opnieuw.", "eng_us": "Removes retirement and resets target age.\nExit without saving, then load the save again.", "fre_fr": "Supprime la retraite et réinitialise l’âge cible.\nQuittez sans sauvegarder, puis rechargez la sauvegarde.", "ger_de": "Entfernt den Ruhestand und setzt das Zielalter zurück.\nOhne zu speichern beenden und neu laden.", "ita_it": "Rimuove il ritiro e reimposta l’età obiettivo.\nEsci senza salvare e ricarica il salvataggio.", "nor_no": "Fjerner pensjonering og tilbakestiller målalderen.\nAvslutt uten å lagre, og last inn lagringen på nytt.", "pol_pl": "Usuwa emeryturę i resetuje wiek docelowy.\nWyjdź bez zapisywania i wczytaj zapis ponownie.", "por_br": "Remove a aposentadoria e renova a idade-alvo.\nSaia sem salvar e carregue o save novamente.", "por_pt": "Remove a reforma e repõe a idade-alvo.\nSaia sem guardar e carregue o save novamente.", "rus_ru": "Отменяет пенсию и сбрасывает целевой возраст.\nВыйдите без сохранения и загрузите сейв снова.", "spa_es": "Quita la jubilación y reinicia la edad objetivo.\nSal sin guardar y carga el guardado de nuevo.", "spa_mx": "Quita el retiro y reinicia la edad objetivo.\nSal sin guardar y carga el guardado de nuevo.", "swe_se": "Tar bort pensionering och återställer målaldern.\nAvsluta utan att spara och läs in sparningen igen.", "tur_tr": "Emekliliği kaldırır ve hedef yaşı sıfırlar.\nKaydetmeden çıkın ve kaydı yeniden yükleyin."}},
