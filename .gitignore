# Runtime diagnostics stay local to the developer/game machine.
compdata_patcher.log
ModCarrerMode/*.log
ModCarrerMode/**/*.log
ModCarrerMode/*_status.ini
ModCarrerMode/*_status.txt
ModCarrerMode/career_retirement_background.local.ini
ModCarrerMode/config/career_retirement_background.local.ini
_codex_reconcile_backup_*/
ModCarrerMode/tools/**/__pycache__/
ModCarrerMode/source/localization/__pycache__/
# Career-specific contracts/requests, never share saves/private slot paths.
ModCarrerMode/runtime/operations/
ModCarrerMode/runtime/career_active_save*
ModCarrerMode/runtime/injury_snapshot.tsv
# Local backup copies never belong in the published package.
ModCarrerMode/backups/
runtime/backups/
ModCarrerMode/mods/*.bak

# Mascot models, textures, captures and conversion data stay local.
data/sceneassets/mascot/
# Calendar DDS payloads and their local availability index stay in the game.
data/ui/imgAssets/careerCompetitionIcons/
ModCarrerMode/source/mascot_photographer/assets/
ModCarrerMode/source/mascot_photographer/last_install.json
ModCarrerMode/source/mascot_photographer/tests/*.bin
ModCarrerMode/source/mascot_photographer/tests/*.jpg
ModCarrerMode/source/mascot_photographer/tests/validation_*.json
**/__pycache__/
ModCarrerMode/source/**/build/
ModCarrerMode/source/**/backups/
*.obj
*.exp
*.lib
ModCarrerMode/source/skip_server_shutdown_notice/*.dll
ModCarrerMode/source/flamengo_pyro/historico_carregado/
# Only the current release of each mod belongs in the package.
# Historical files are archived outside the repository, in the studies folder.
ModCarrerMode/mods/*_v[0-9]*/
ModCarrerMode/mods/**/*_v[0-9]*.dll
ModCarrerMode/source/kickoff_modern_v*/
ModCarrerMode/mods/enabled_*.txt
# Duplicate/backup competition packages are not runtime inputs.
dlc/dlc_FootballCompEng/dlc/FootballCompEng/FootballCompEng/
*.rar

# Competition models and dynamic fixture caches are installed locally.
data/sceneassets/entrance_props/
data/sceneassets/var_cabin/
ModCarrerMode/mods/**/source/
ModCarrerMode/mods/**/*_installation.json
ModCarrerMode/source/var_cabin/test_dependencies/
code-release/
# Retired server-notice plugin: local rollback copies are not distributed.
ModCarrerMode/mods/skip_server_shutdown_notice/
ModCarrerMode/source/skip_server_shutdown_notice/
# Local smoke-machine conversion backups and test-only dependencies.
ModCarrerMode/source/smoke_machine/historico_carregado/
ModCarrerMode/source/smoke_machine/test_dependencies/
ModCarrerMode/source/smoke_machine/*.blend1
# Ball-stand models/textures stay installed locally, outside source releases.
data/sceneassets/standball/
# Native cloth session acknowledgement is generated by the running game.
ModCarrerMode/mods/cloth_motion/runtime_state.txt
